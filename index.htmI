<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>صندوق من</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #f3f5f7;
  color: #222;
}

.container {
  max-width: 500px;
  margin: auto;
  padding: 20px;
}

h1 {
  text-align: center;
  margin-bottom: 20px;
}

.balance {
  background: white;
  border-radius: 20px;
  padding: 25px;
  text-align: center;
  box-shadow: 0 3px 15px rgba(0,0,0,.08);
  margin-bottom: 20px;
}

.balance-title {
  color: #777;
  font-size: 16px;
}

#balance {
  font-size: 32px;
  font-weight: bold;
  margin-top: 8px;
}

.form {
  background: white;
  padding: 20px;
  border-radius: 20px;
  box-shadow: 0 3px 15px rgba(0,0,0,.08);
}

input, select, button {
  width: 100%;
  padding: 14px;
  margin-top: 10px;
  border-radius: 12px;
  border: 1px solid #ddd;
  font-size: 16px;
}

button {
  border: none;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

.add {
  background: #16803c;
}

.transactions {
  margin-top: 20px;
}

.transaction {
  background: white;
  padding: 15px;
  margin-bottom: 10px;
  border-radius: 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2px 10px rgba(0,0,0,.06);
}

.income {
  color: #16803c;
  font-weight: bold;
}

.expense {
  color: #d62828;
  font-weight: bold;
}

.delete {
  width: auto;
  background: #d62828;
  padding: 8px 12px;
  margin: 0;
  font-size: 13px;
}

.empty {
  text-align: center;
  color: #888;
  padding: 20px;
}
</style>
</head>

<body>

<div class="container">

<h1>💰 صندوق من</h1>

<div class="balance">
  <div class="balance-title">موجودی صندوق</div>
  <div id="balance">0</div>
  <div>تومان</div>
</div>

<div class="form">

<select id="type">
  <option value="income">دریافتی</option>
  <option value="expense">پرداختی</option>
</select>

<input
  type="number"
  id="amount"
  placeholder="مبلغ را وارد کنید"
/>

<input
  type="text"
  id="description"
  placeholder="توضیحات"
/>

<button class="add" onclick="addTransaction()">
  ثبت تراکنش
</button>

</div>

<div class="transactions">
  <h2>تراکنش‌ها</h2>
  <div id="list"></div>
</div>

</div>

<script>

let transactions =
JSON.parse(localStorage.getItem("cashbox")) || [];

function save() {
  localStorage.setItem(
    "cashbox",
    JSON.stringify(transactions)
  );
}

function formatNumber(number) {
  return Number(number).toLocaleString("fa-IR");
}

function update() {

  let balance = 0;

  transactions.forEach(t => {

    if (t.type === "income") {
      balance += Number(t.amount);
    } else {
      balance -= Number(t.amount);
    }

  });

  document.getElementById("balance").innerText =
    formatNumber(balance);

  let list = document.getElementById("list");

  if (transactions.length === 0) {
    list.innerHTML =
      '<div class="empty">هنوز تراکنشی ثبت نشده است</div>';
    return;
  }

  list.innerHTML = "";

  transactions
    .slice()
    .reverse()
    .forEach((t, index) => {

      let div = document.createElement("div");

      div.className = "transaction";

      let realIndex =
        transactions.length - 1 - index;

      div.innerHTML = `

        <div>
          <div>
            ${t.description || "بدون توضیح"}
          </div>

          <div class="${t.type === "income" ? "income" : "expense"}">
            ${t.type === "income" ? "+" : "-"}
            ${formatNumber(t.amount)}
            تومان
          </div>
        </div>

        <button
          class="delete"
          onclick="deleteTransaction(${realIndex})">
          حذف
        </button>

      `;

      list.appendChild(div);

    });
}

function addTransaction() {

  let type =
    document.getElementById("type").value;

  let amount =
    document.getElementById("amount").value;

  let description =
    document.getElementById("description").value;

  if (!amount || Number(amount) <= 0) {
    alert("لطفاً مبلغ را وارد کنید");
    return;
  }

  transactions.push({

    type: type,

    amount: Number(amount),

    description: description,

    date: new Date().toLocaleString("fa-IR")

  });

  save();

  document.getElementById("amount").value = "";

  document.getElementById("description").value = "";

  update();
}

function deleteTransaction(index) {

  if (confirm("این تراکنش حذف شود؟")) {

    transactions.splice(index, 1);

    save();

    update();

  }

}

update();

</script>

</body>
</html>
