<!doctype html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">

<title>صندوق من</title>

<style>
*{box-sizing:border-box}

body{
margin:0;
background:#f2f4f7;
font-family:-apple-system,BlinkMacSystemFont,"Tahoma",sans-serif;
color:#17202a
}

main{
max-width:520px;
margin:auto;
padding:18px 14px 35px
}

.top{
display:flex;
justify-content:space-between;
align-items:center;
margin:4px 3px 15px
}

h1{margin:0;font-size:28px}

.card{
background:#fff;
border-radius:22px;
padding:18px;
margin:12px 0;
box-shadow:0 3px 16px #0000000b
}

.center{text-align:center}

.small{
color:#737b86;
font-size:14px
}

.balance{
font-size:38px;
font-weight:800;
margin:7px 0 15px
}

.stats{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px
}

.stat{
background:#f7f8fa;
border-radius:15px;
padding:11px
}

.stat b{
display:block;
font-size:19px;
margin-top:4px
}

.green{color:#138a4b}
.red{color:#c0392b}

.actions{
display:grid;
grid-template-columns:1fr 1fr;
gap:10px
}

.btn{
border:0;
border-radius:17px;
padding:17px;
font-size:18px;
font-weight:800;
color:#fff
}

.in{background:#159957}
.out{background:#d94b3f}

input,textarea{
width:100%;
border:1px solid #e0e4e9;
border-radius:14px;
padding:14px;
font-size:17px;
margin:6px 0 10px;
background:#fff
}

.save{
width:100%;
border:0;
border-radius:14px;
padding:15px;
background:#1d2733;
color:white;
font-size:17px;
font-weight:800
}

.row{
display:flex;
justify-content:space-between;
gap:10px;
padding:13px 0;
border-bottom:1px solid #eee
}

.row:last-child{border:0}

.desc{font-weight:700}

.date{
font-size:12px;
color:#8a929b;
margin-top:4px
}

.amt{
font-weight:800;
white-space:nowrap
}

.del{
margin-top:5px;
border:0;
border-radius:8px;
padding:6px 9px;
color:#666
}

.hidden{display:none}

.empty{
text-align:center;
color:#8a929b;
padding:18px
}
</style>
</head>

<body>

<main>

<div class="top">
<h1>صندوق من</h1>
<span class="small">صندوق مغازه</span>
</div>

<div class="card center">

<div class="small">موجودی فعلی</div>

<div id="bal" class="balance">۰</div>

<div class="stats">

<div class="stat">
<span class="green">دریافتی</span>
<b id="tin">۰</b>
</div>

<div class="stat">
<span class="red">پرداختی</span>
<b id="tout">۰</b>
</div>

</div>
</div>

<div class="card">

<div class="actions">

<button class="btn in" onclick="show('in')">
＋ دریافت
</button>

<button class="btn out" onclick="show('out')">
－ پرداخت
</button>

</div>

</div>

<div id="form" class="card hidden">

<h3 id="title">ثبت دریافت</h3>

<input
id="amount"
inputmode="numeric"
placeholder="مبلغ (تومان)"
>

<textarea
id="note"
rows="2"
placeholder="توضیحات، مثلاً فروش نقدی">
</textarea>

<button class="save" onclick="save()">
ثبت حساب
</button>

</div>

<div class="card">

<h3>آخرین تراکنش‌ها</h3>

<div id="list"></div>

</div>

</main>

<script>

const K="cashbox-ios-v2";

let data=JSON.parse(
localStorage.getItem(K)||"[]"
);

let kind="in";

const fa=n=>
Number(n).toLocaleString("fa-IR");

function show(k){

kind=k;

form.classList.remove("hidden");

title.textContent=
k==="in"
?"ثبت دریافت"
:"ثبت پرداخت";

amount.value="";
note.value="";

amount.focus();

}

function save(){

let a=Number(
amount.value.replace(/[٬,\s]/g,"")
);

if(!a){

alert("مبلغ را وارد کنید");

return;

}

data.unshift({

id:Date.now(),

kind,

amount:a,

note:note.value.trim(),

date:new Date().toLocaleString("fa-IR")

});

localStorage.setItem(
K,
JSON.stringify(data)
);

form.classList.add("hidden");

render();

}

function removeTx(id){

if(confirm("این تراکنش حذف شود؟")){

data=data.filter(
x=>x.id!==id
);

localStorage.setItem(
K,
JSON.stringify(data)
);

render();

}

}

function render(){

let i=data
.filter(x=>x.kind==="in")
.reduce(
(s,x)=>s+x.amount,
0
);

let o=data
.filter(x=>x.kind==="out")
.reduce(
(s,x)=>s+x.amount,
0
);

bal.textContent=fa(i-o);

tin.textContent=fa(i);

tout.textContent=fa(o);

list.innerHTML=data.length

?data.slice(0,50).map(x=>`

<div class="row">

<div>

<div class="desc">
${x.note ||
(x.kind==="in"?"دریافت":"پرداخت")}
</div>

<div class="date">
${x.date}
</div>

</div>

<div style="text-align:left">

<div class="amt ${
x.kind==="in"?"green":"red"
}">

${x.kind==="in"?"+":"−"}
${fa(x.amount)}

</div>

<button
class="del"
onclick="removeTx(${x.id})">

حذف

</button>

</div>

</div>

`).join("")

:'<div class="empty">هنوز تراکنشی ثبت نشده</div>';

}

render();

</script>

</body>
</html>
