<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>صندوق من</title>

<style>
* {
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body {
  margin: 0;
  background: #f4f6f8;
  color: #222;
}

.container {
  max-width: 600px;
  margin: auto;
  padding: 18px;
}

h1 {
  text-align: center;
  margin-bottom: 20px;
}

.balance {
  background: white;
  border-radius: 20px;
  padding: 25px;
  text-align: center;
  box-shadow: 0 3px 12px #0001;
  margin-bottom: 18px;
}

.balance-title {
  color: #777;
  font-size: 16px;
}

.balance-number {
  font-size: 32px;
  font-weight: bold;
  margin-top: 8px;
}

.cards {
  display: flex;
  gap: 12px;
  margin-bottom: 18px;
}

.card {
  flex: 1;
  background: white;
  border-radius: 16px;
  padding: 18px 10px;
  text-align: center;
  box-shadow: 0 2px 8px #0001;
}

.income {
  color: #159447;
}

.expense {
  color: #d93025;
}

.card-title {
  font-size: 14px;
  color: #777;
}

.card-number {
  font-size: 20px;
  font-weight: bold;
  margin-top: 7px;
}

.form {
  background: white;
  border-radius: 18px;
  padding: 18px;
  box-shadow: 0 2px 8px #0001;
  margin-bottom: 18px;
}

input, select, button {
  width: 100%;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid #ddd;
  font-size: 16px;
  margin-bottom: 10px;
}

button {
  border: none;
  background: #159447;
  color: white;
  font-weight: bold;
  cursor: pointer;
}

button:active {
  transform: scale(.98);
}

.transactions {
  background: white;
  border-radius: 18px;
  padding: 18px;
  box-shadow: 0 2px 8px #0001;
}

.transaction {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 4px;
  border-bottom: 1px solid #eee;
}

.transaction:last-child {
  border-bottom: none;
}

.description {
  font-weight: bold;
}

.date {
  color: #999;
  font-size: 12px;
  margin-top: 4px;
}

.amount {
  font-weight: bold;
  font-size: 16px;
}

.delete {
  background: #eee;
  color: #d93025;
  width: auto;
  padding: 5px 9px;
  margin: 5px 0 0 8px;
  font-size: 12px;
}

.empty {
  text-align: center;
  color: #999;
  padding: 20px;
}
</style>
</head>

<body>

<div class="container">

<h1>💰 صندوق من</h1>

<div class="balance">
  <div class="balance-title">موجودی صندوق</div>
  <div class="balance-number" id="balance">0</div>
  <div>تومان</div>
</div>

<div class="cards">

  <div class="card">
    <div class="card-title income">دریافتی</div>
    <div class="card-number income" id="totalIncome">0</div>
  </div>

  <div class="card">
    <div class="card-title expense">پرداختی</div>
    <div class="card-number expense" id="totalExpense">0</div>
  </div>

</div>

<div class="form">

  <select id="type">
    <option value="income">دریافتی 💚</option>
    <option value="expense">پرداختی ❤️</option>
  </select>

  <input
    type="number"
    id="amount"
    placeholder="مبلغ"
    inputmode="numeric"
  >

  <input
    type="text"
    id="description"
    placeholder="توضیحات"
  >

  <button onclick="addTransaction()">
    ثبت تراکنش
  </button>

</div>

<div class="transactions">

<h2>تراکنش‌ها</h2>

<div id="list"></div>

</div>

</div>

<script>

let transactions =
  JSON.parse(localStorage.getItem("cashbox")) || [];

function save() {
  localStorage.setItem(
    "cashbox",
    JSON.stringify(transactions)
  );
}

function formatNumber(number) {
  return Number(number).toLocaleString("fa-IR");
}

function addTransaction() {

  const type =
    document.getElementById("type").value;

  const amount =
    Number(document.getElementById("amount").value);

  const description =
    document.getElementById("description").value.trim();

  if (!amount || amount <= 0) {
    alert("لطفاً مبلغ را وارد کنید.");
    return;
  }

  transactions.unshift({

    id: Date.now(),

    type: type,

    amount: amount,

    description:
      description || (type === "income"
        ? "دریافتی"
        : "پرداختی"),

    date:
      new Date().toLocaleString("fa-IR")

  });

  save();

  document.getElementById("amount").value = "";
  document.getElementById("description").value = "";

  update();

}

function deleteTransaction(id) {

  if (!confirm("این تراکنش حذف شود؟")) {
    return;
  }

  transactions =
    transactions.filter(item => item.id !== id);

  save();

  update();

}

function update() {

  let income = 0;
  let expense = 0;

  transactions.forEach(item => {

    if (item.type === "income") {
      income += item.amount;
    } else {
      expense += item.amount;
    }

  });

  const balance = income - expense;

  document.getElementById("totalIncome").textContent =
    formatNumber(income);

  document.getElementById("totalExpense").textContent =
    formatNumber(expense);

  document.getElementById("balance").textContent =
    formatNumber(balance);

  const list =
    document.getElementById("list");

  if (transactions.length === 0) {

    list.innerHTML =
      '<div class="empty">هنوز تراکنشی ثبت نشده است</div>';

    return;
  }

  list.innerHTML = transactions.map(item => {

    const isIncome =
      item.type === "income";

    return `

      <div class="transaction">

        <div>

          <div class="description">
            ${item.description}
          </div>

          <div class="date">
            ${item.date}
          </div>

        </div>

        <div style="text-align:left">

          <div class="amount ${isIncome ? "income" : "expense"}">
            ${isIncome ? "+" : "-"}
            ${formatNumber(item.amount)}
          </div>

          <button
            class="delete"
            onclick="deleteTransaction(${item.id})"
          >
            حذف
          </button>

        </div>

      </div>

    `;

  }).join("");

}

update();

</script>

</body>
</html>
